# Единый источник версий: его читают CI, установщик и скрипт обновления Xray.
# В Makefile пакетов версия продублирована (OpenWrt собирает пакет из своей
# копии каталога), а CI сверяет, что значения совпадают и с тегом.

PKG_VERSION:=0.3.1
PKG_RELEASE:=1

# Xray-core: версия бинарников (upstream) и пакета из фида (fallback)
XRAY_VERSION:=26.10.21
XRAY_TAG:=v26.10.21
XRAY_PKG_VERSION:=26.10.21-r1